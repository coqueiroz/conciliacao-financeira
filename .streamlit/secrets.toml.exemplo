# Configurações do painel. No Streamlit Cloud: App > Settings > Secrets, cole estas linhas preenchidas.
# No computador: copie este arquivo para ".streamlit/secrets.toml" (ele não vai para o GitHub).

# "demonstracao" (padrão, para portfólio) ou "cliente" (uso real: sem dados de exemplo)
MODO = "cliente"
# Nome que aparece no título do painel (opcional)
NOME_CLIENTE = "Loja Exemplo"

# Remetente dos e-mails. GMAIL_SENHA_APP é uma "senha de app" de 16 letras: myaccount.google.com/apppasswords
GMAIL_USUARIO = "seu.email@gmail.com"
GMAIL_SENHA_APP = "abcdefghijklmnop"
