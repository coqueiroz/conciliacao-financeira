# Configuração do remetente para o envio de e-mail pelo painel.
# - No Streamlit Cloud: App > Settings > Secrets, cole estas linhas preenchidas.
# - No computador: copie este arquivo para ".streamlit/secrets.toml" (ele não vai para o GitHub).
# GMAIL_SENHA_APP é uma "senha de app" de 16 letras: myaccount.google.com/apppasswords

GMAIL_USUARIO = "seu.email@gmail.com"
GMAIL_SENHA_APP = "abcdefghijklmnop"
